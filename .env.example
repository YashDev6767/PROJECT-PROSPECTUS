# Copy to .env and adjust. Never commit the real .env file.

# --- API ---
NODE_ENV=development
API_PORT=4000
# Origin(s) allowed to call the API from a browser (comma separated).
CORS_ORIGIN=http://localhost:5173

# --- Progression engine ---
# "Today" and the current time are evaluated in this IANA time zone, not the server's UTC.
APP_TIME_ZONE=Asia/Kolkata
# Risk thresholds on buffer ratio = available teaching hours / remaining syllabus hours.
RISK_ON_TRACK_BUFFER=1.15
RISK_TIGHT_BUFFER=1.0
# Exam type that marks the syllabus-completion deadline (falls back to the semester end when not scheduled).
SYLLABUS_DEADLINE_EXAM_TYPE=END_TERM

# --- Database (PostgreSQL) ---
# Matches docker-compose.yml. Replace the placeholder password with your own.
POSTGRES_USER=prospectus
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=prospectus
POSTGRES_PORT=5432
DATABASE_URL=postgresql://prospectus:change-me-locally@localhost:5432/prospectus?schema=public
# Separate database used only by `npm run test:integration`. It is WIPED on every run, so never point it at real data.
TEST_DATABASE_URL=postgresql://prospectus:change-me-locally@localhost:5432/prospectus_test?schema=public

# --- Web (only VITE_-prefixed values are exposed to the browser; never put secrets here) ---
# Leave empty in development: Vite proxies /api to the API.
VITE_API_BASE_URL=
