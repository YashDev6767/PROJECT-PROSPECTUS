# Copy to .env and adjust. Never commit the real .env file.

# --- API ---
NODE_ENV=development
API_PORT=4000
# Origin(s) allowed to call the API from a browser (comma separated).
CORS_ORIGIN=http://localhost:5173

# --- Progression engine ---
# "Today" and the current time are evaluated in this IANA time zone, not the server's UTC.
APP_TIME_ZONE=Asia/Kolkata
# Risk thresholds on buffer ratio = available teaching hours / remaining syllabus hours.
RISK_ON_TRACK_BUFFER=1.15
RISK_TIGHT_BUFFER=1.0
# Exam type that marks the syllabus-completion deadline (falls back to the semester end when not scheduled).
SYLLABUS_DEADLINE_EXAM_TYPE=END_TERM

# --- Database (PostgreSQL) ---
# Matches docker-compose.yml. Replace the placeholder password with your own.
POSTGRES_USER=prospectus
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=prospectus
POSTGRES_PORT=5432
DATABASE_URL=postgresql://prospectus:change-me-locally@localhost:5432/prospectus?schema=public
# Separate database used only by `npm run test:integration`. It is WIPED on every run, so never point it at real data.
TEST_DATABASE_URL=postgresql://prospectus:change-me-locally@localhost:5432/prospectus_test?schema=public

# --- Web (only VITE_-prefixed values are exposed to the browser; never put secrets here) ---
# Leave empty in development: Vite proxies /api to the API.
VITE_API_BASE_URL=

# --- Access control ---
# Local development: the "Preview as" role picker (spoofable demo headers) is ON by default and OFF when NODE_ENV=production.
# Only the strings true/false (also 1/0, yes/no, on/off) are accepted. Never set this to true on a publicly reachable server.
# ALLOW_DEMO_HEADERS=false

# Restricted evaluation sign-in (server-verified signed session cookie). Both unset = no login page access.
#   1) npm run auth:hash -- 'a long passphrase'      -> prints a scrypt hash
#   2) put the hash in AUTH_USERS (one JSON line) and set a random SESSION_SECRET of 32+ characters
#   Roles: admin | campus_manager | faculty | student. A faculty account needs the faculty member's id ("facultyId"); a student account needs the one batch it may see ("batchId") — both from the API. A campus manager needs `campusIds` (e.g. ["rgib"]); an admin without `campusIds` is organization-wide, with them it is limited to those campuses. Campus scope: manager = campusIds, faculty = campus of the linked faculty record, student = campus of the linked batch; no scope = no access. `npm run auth:add` takes the link as its last argument.
# AUTH_USERS=[{"email":"admin@example.edu","role":"admin","name":"Admin","passwordHash":"scrypt:..."}]
# SESSION_SECRET=
# SESSION_TTL_HOURS=8
